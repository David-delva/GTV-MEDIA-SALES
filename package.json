{
  "name": "gtv-media-sales",
  "version": "0.1.0",
  "type": "module",
  "description": "GTV Media Sales — Plateforme commerciale interactive de vente d'espaces publicitaires",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "tsc --project tsconfig.server.json",
    "build:frontend": "vite build",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:fe": "tsc --project tsconfig.frontend.json --noEmit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.2",
    "jest": "^29.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "src/frontend"
    ]
  }
}
