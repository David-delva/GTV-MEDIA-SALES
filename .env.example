# =============================================================================
# GTV Media Sales — Variables d'environnement (développement)
# Copiez vers .env; le serveur charge .env automatiquement.
# Ne jamais committer .env ni utiliser ces identifiants en production.
# =============================================================================

NODE_ENV=development
PORT=3000

# Base de données PostgreSQL [A CONFIGURER]
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gtv_media_sales
DB_USER=
DB_PASSWORD=

# JWT [A CONFIGURER — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"]
JWT_SECRET=

# Frontend
VITE_API_URL=/api
